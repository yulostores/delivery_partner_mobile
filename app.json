{
  "expo": {
    "name": "Delivery-Partner",
    "slug": "yulodeliveryportal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yulostores.delivery",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yulo Delivery Partner uses your location to match you with nearby orders and share your position with the customer during a delivery.",
          "locationAlwaysAndWhenInUsePermission": "Yulo Delivery Partner shares your location with the customer while you are online, so they can watch their order arrive. Location is only collected while you are on duty and stops the moment you go offline.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yulo Delivery Partner accesses your photos so you can upload verification documents and a profile selfie.",
          "cameraPermission": "Yulo Delivery Partner uses the camera to capture verification documents and your selfie.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "color": "#FF5A00"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "358c2405-5227-4b93-9490-11a7058900be"
      }
    },
    "owner": "vescavias-team"
  }
}
